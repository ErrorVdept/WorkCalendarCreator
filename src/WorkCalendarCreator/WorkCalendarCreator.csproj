<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\LOGO.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


	<Target Name="FixBaseHref" AfterTargets="Publish">
		<PropertyGroup>
			<IndexHtmlPath>$(PublishDir)wwwroot\index.html</IndexHtmlPath>
			<IndexHtmlPath Condition="'$(OS)' != 'Windows_NT'">$(PublishDir)wwwroot/index.html</IndexHtmlPath>
		</PropertyGroup>

		<ReadLinesFromFile File="$(IndexHtmlPath)">
			<Output TaskParameter="Lines" ItemName="IndexLines" />
		</ReadLinesFromFile>

		<ItemGroup>
			<ModifiedIndexLines Include="@(IndexLines)">
				<ReplacedLine>$([System.Text.RegularExpressions.Regex]::Replace('%(Identity)', '&lt;base href=&quot;/&quot; /&gt;', '&lt;base href=&quot;/WorkCalendarCreator/&quot; /&gt;'))</ReplacedLine>
			</ModifiedIndexLines>
		</ItemGroup>

		<WriteLinesToFile
		  File="$(IndexHtmlPath)"
		  Lines="@(ModifiedIndexLines->'%(ReplacedLine)')"
		  Overwrite="true"
		  Encoding="UTF-8" />

		<Message Text="✅ Base href заменён на /WorkCalendarCreator/ в $(IndexHtmlPath)" Importance="high" />
	</Target>
</Project>
